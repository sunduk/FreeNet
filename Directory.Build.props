<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Nullable>enable</Nullable>

    <!-- Semantic version base -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString('yyyyMMddHHmmss'))</BuildTimestampUtc>

    <!-- Automatically generate package/assembly semantic versions for build outputs -->
    <Version Condition="'$(Version)' == '' and '$(Configuration)' == 'Release'">$(VersionPrefix)</Version>
    <Version Condition="'$(Version)' == '' and '$(Configuration)' != 'Release'">$(VersionPrefix)-dev.$(BuildTimestampUtc)</Version>

    <!-- Stable runtime binding version; increment for intentional breaking API changes -->
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">$(Version)+sha.$(SourceRevisionId)</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
